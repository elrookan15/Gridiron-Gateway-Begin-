{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:compliance": "tsx scripts/runComplianceTests.ts",
    "test:rallysafe": "tsx src/rallySafeClearinghouseTestSuite.ts",
    "test:capgm": "tsx src/capGmTestSuite.ts",
    "test:parental-consent": "tsx src/parentalConsentTestSuite.ts",
    "test:pre-commit": "tsx scripts/runAllPreCommitChecks.ts",
    "ingest:cfbd": "tsx scripts/ingestion/cfbdTeamsSync.ts",
    "ingest:sidearm": "tsx scripts/ingestion/sidearmStaffScraper.ts",
    "ingest:juco-csv": "tsx scripts/ingestion/jucoPrepCsvImport.ts data/ingestion/templates/juco_prep_programs.template.csv",
    "ingest:monthly": "tsx scripts/ingestion/runMonthlyPipeline.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@radix-ui/react-slider": "^1.4.7",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cheerio": "^0.22.35",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
