{
  "version": "0.1.0",
  "name": "roundblock",
  "instructions": [
    {
      "name": "proposeTrade",
      "accounts": [
        { "name": "sender", "isMut": true, "isSigner": true },
        { "name": "recipient", "isMut": false, "isSigner": false },
        { "name": "league", "isMut": false, "isSigner": false },
        { "name": "tradeEscrow", "isMut": true, "isSigner": false },
        { "name": "senderUsdcAta", "isMut": true, "isSigner": false },
        { "name": "collateralVaultUsdc", "isMut": true, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "durationSeconds", "type": "i64" },
        { "name": "requiresCollateral", "type": "bool" },
        { "name": "collateralAmountCents", "type": "u64" }
      ]
    },
    {
      "name": "acceptTrade",
      "accounts": [
        { "name": "recipient", "isMut": true, "isSigner": true },
        { "name": "tradeEscrow", "isMut": true, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "reclaimTrade",
      "accounts": [
        { "name": "sender", "isMut": true, "isSigner": true },
        { "name": "tradeEscrow", "isMut": true, "isSigner": false }
      ],
      "args": []
    }
  ],
  "accounts": [
    {
      "name": "TradeEscrow",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "sender", "type": "publicKey" },
          { "name": "recipient", "type": "publicKey" },
          { "name": "league", "type": "publicKey" },
          { "name": "createdAt", "type": "i64" },
          { "name": "expiresAt", "type": "i64" },
          { "name": "status", "type": { "defined": "TradeStatus" } },
          { "name": "requiresCollateral", "type": "bool" },
          { "name": "collateralAmount", "type": "u64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "errors": [
    { "code": 6000, "name": "TradeExpired", "msg": "Temporal lock expired: This trade offer has expired on-chain." },
    { "code": 6001, "name": "TradeNotExpired", "msg": "Trade offer has not expired yet: Cannot reclaim active trade." },
    { "code": 6002, "name": "InvalidStatus", "msg": "Invalid trade status for this operation." },
    { "code": 6003, "name": "Unauthorized", "msg": "Unauthorized account for trade resolution." }
  ]
}
